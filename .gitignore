# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
ENV/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Model weights (too large for git)
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.onnx
*.engine

# Training run artifacts: checkpoint-N/, final_lora_adapter/ and the
# validation image grids. The *.safetensors rule above already covers the
# weights, but not the adapter_config.json or the sample PNGs beside them.
lora_weights/

# Hugging Face cache
.cache/

# Dataset images
dataset/train/images/*.png
dataset/train/images/*.jpg
dataset/val/images/*.png
dataset/val/images/*.jpg

# Experiment outputs
experiments/samples/*.png
experiments/samples/*.jpg
experiments/latency/*.json
experiments/latency/*.csv

# Keep metrics JSON
!experiments/metrics/*.json

# Wandb
wandb/
.wandb/

# Logs
logs/
*.log
runs/
