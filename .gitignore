# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
ENV/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Model weights (too large for git)
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.onnx
*.engine

# Training run artifacts: checkpoint-N/, final_lora_adapter/ and the
# validation image grids. The *.safetensors rule above already covers the
# weights, but not the adapter_config.json or the sample PNGs beside them.
lora_weights/

# Hugging Face cache
.cache/

# Dataset images
dataset/train/images/*.png
dataset/train/images/*.jpg
dataset/val/images/*.png
dataset/val/images/*.jpg

# Experiment outputs
experiments/samples/*.png
experiments/samples/*.jpg
experiments/latency/*.json
experiments/latency/*.csv

# Bulk eval renders: 1000 images per arm, regenerate with run_eval.py.
# Committing these would add ~1GB and they carry no information the
# metrics JSON doesn't already summarise.
experiments/eval_generated*/

# Per-pair frames from the comparison script. The composed grid is the
# artifact worth keeping; these are its raw inputs.
experiments/comparisons/pair_*.png

# Also exported to disk from the HF cache, and regenerable:
#   python src/data/export_wikiart_val.py
dataset/wikiart_val/

# Keep metrics JSON, and the composed comparison grids they refer to --
# these are the evaluation results worth version-controlling.
!experiments/metrics/*.json

# Wandb
wandb/
.wandb/

# Logs
logs/
*.log
runs/
